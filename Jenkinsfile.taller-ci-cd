#!/usr/bin/env groovy

pipeline {
    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_NAME = 'mi-app'
        IMAGE_TAG = 'latest'
        CONTAINER_NAME = 'mi-app'
        SONAR_PROJECT_KEY = 'mi-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn -B -DskipTests clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn -B -Djacoco.skip=true -DforkCount=0 -DexcludedGroups=au.com.equifax.cicddemo.domain.SystemTest test'
            }
        }

        stage('Static Analysis (SonarQube)') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn -B sonar:sonar -Dsonar.projectKey=${SONAR_PROJECT_KEY} -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.login=$SONAR_AUTH_TOKEN'
                }
            }
        }

        stage('Quality Gate (SonarQube)') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
            }
        }

        stage('Container Security Scan (Trivy)') {
            steps {
                sh '''
                    if ! command -v trivy >/dev/null 2>&1; then
                        echo "Trivy no está instalado en el agente Jenkins."
                        exit 1
                    fi
                    trivy image --severity CRITICAL --exit-code 1 --no-progress ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Deploy') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                }
            }
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME} >/dev/null 2>&1 || true
                    docker run -d --name ${CONTAINER_NAME} -p 80:80 -e SERVER_PORT=80 ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }
    }

    post {
        failure {
            echo 'Pipeline falló: revisar logs de Build/Test/SonarQube/Trivy.'
        }
        always {
            sh '''
                docker ps -a --filter "name=${CONTAINER_NAME}" --format "{{.Names}} {{.Status}}" || true
                docker image ls ${IMAGE_NAME} --format "{{.Repository}}:{{.Tag}}" || true
            '''
            deleteDir()
        }
    }
}
